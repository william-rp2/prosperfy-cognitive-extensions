# Template para /home/will/.config/prosperfy-cognitive-v2-homolog/supabase-ops.env
# (mesmo diretorio do api-runtime-sprint03.env ja usado pela API Homolog).
#
# Copiar para o caminho acima, preencher os valores reais, e:
#   chmod 0600 /home/will/.config/prosperfy-cognitive-v2-homolog/supabase-ops.env
# NUNCA commitar o arquivo preenchido — so este .example fica no git.
#
# COGNITIVE_DB_URL / COGNITIVE_DB_ADMIN_URL / COGNITIVE_DB_WORKER_URL ja
# vem do api-runtime-sprint03.env (primeiro EnvironmentFile da unit) — nao
# precisa repetir aqui.

# Liga o ComposioMcpAdapter real (adapters/composio/client.py). Sem isso o
# CLI recusa rodar (fail-closed) — ver ops/supabase_keepalive_cli.py.
COGNITIVE_LIVE_COMPOSIO_MCP=1

# Endpoint MCP hospedado do Composio (Streamable HTTP) para este workspace.
# HUMAN_BLOCKER da track P0: nao foi possivel confirmar/provisionar este
# valor de forma autonoma (inspecionar env do host foi bloqueado pelo
# classifier de auto mode como acao sensivel) — preencher com o valor real
# do workspace Composio "Supabase - Hermes" e demais contas.
COMPOSIO_MCP_URL=

# Bearer token do workspace Composio. NUNCA versionar o valor real.
COMPOSIO_MCP_API_KEY=

# Slug do tenant no Cognitive Homolog (ja existe — nao precisa criar).
COGNITIVE_TENANT_SLUG=prosperfy-homolog
