# .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.coverage.*
*.coverage

# Node / frontend
node_modules/
apps/*/dist/
apps/*/data/
*.tsbuildinfo
apps/*/vite.config.js
apps/*/vite.config.d.ts

# Environments
.env
.venv
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime
*.pid
*.log
*.sqlite3