+def _has_stale_plugin_registry(manager) -> bool:
+    """True when the in-process plugin registry no longer matches the config:
+    a plugin enabled (or disabled) after this process started is not reflected
+    in the cached discovery snapshot. Generic — no plugin name hardcoded.
+
+    Only plugins gated by ``plugins.enabled`` participate (user/standalone/
+    entry-point). Bundled backends/platforms and exclusive/model-provider
+    plugins are governed by other config and never count as stale.
+    """
+    enabled = _get_enabled_plugins()
+    disabled = _get_disabled_plugins()
+    for plugin_id, loaded in manager._plugins.items():
+        manifest = getattr(loaded, "manifest", None)
+        source = getattr(manifest, "source", "") or ""
+        kind = getattr(manifest, "kind", "") or ""
+        if kind in ("exclusive", "model-provider"):
+            continue
+        if source == "bundled" and kind in ("backend", "platform"):
+            continue
+        manifest_name = getattr(manifest, "name", "") or ""
+        should_be_enabled = (
+            enabled is not None
+            and plugin_id not in disabled
+            and manifest_name not in disabled
+            and (plugin_id in enabled or manifest_name in enabled)
+        )
+        if bool(getattr(loaded, "enabled", False)) != bool(should_be_enabled):
+            return True
+    return False
+
