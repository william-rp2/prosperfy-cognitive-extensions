+    checked before plugin commands by the dispatcher, and register_command()
+    rejects names that conflict with built-ins.
+    """
+    manager = _ensure_plugins_discovered()
+    if _has_stale_plugin_registry(manager):
+        manager = _ensure_plugins_discovered(force=True)
+    entry = manager._plugin_commands.get(name)
     return entry["handler"] if entry else None
 
 
