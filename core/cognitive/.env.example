# Cognitive Gateway — variáveis de ambiente

# ─── Gateway ─────────────────────────────────────────────────────────────
COGNITIVE_HOST=0.0.0.0
COGNITIVE_PORT=8800

# Credential do cliente → Gateway (Sprint 0.1: valor estático dev)
# Sprint 0.4+: substituir por service_identities no banco
COGNITIVE_GATEWAY_CREDENTIAL=dev-secret

# Tenant e actor para o cliente dev (pareados com COGNITIVE_GATEWAY_CREDENTIAL)
COGNITIVE_DEV_TENANT_ID=prosperfy
COGNITIVE_DEV_ACTOR_ID=william

# ─── Adapter MCP ─────────────────────────────────────────────────────────
# 0 = MockSkillsAdapter (default dev/CI); 1 = ProsperfySkillsAdapter real
COGNITIVE_LIVE_MCP=0

MCP_PROSPERFYSKILLS_API_KEY=
MCP_PROSPERFYSKILLS_HOST=skills.prosperfy.com.br

# ─── Database (Sprint 0.2+) ──────────────────────────────────────────────
# Homolog project ref esperado: esvjfkknrzzziafovwrv
# NUNCA usar project ref wioorhtdwnfujkrynxij (produção/Hermes)
#
# COGNITIVE_MODE=in_memory  → dev/CI sem Postgres (Sprint 0.1 retrocompat)
# COGNITIVE_MODE=database   → DB obrigatório; fail-closed
#
# COGNITIVE_DB_ADMIN_URL=     # migrations/admin (secret remoto — não commitar)
# COGNITIVE_APP_PASSWORD=     # bootstrap cognitive_app (secret remoto)
# COGNITIVE_WORKER_PASSWORD=  # bootstrap cognitive_worker (secret remoto)
# COGNITIVE_DB_URL=           # gerado pós-bootstrap (secret remoto)
# COGNITIVE_DB_WORKER_URL=    # gerado pós-bootstrap (secret remoto)

# ─── Audit / Redaction ───────────────────────────────────────────────────
# Campos adicionais a redigir nos inputs de audit (separados por vírgula)
COGNITIVE_LOG_REDACT_FIELDS=api_key,password,token,secret,credential
