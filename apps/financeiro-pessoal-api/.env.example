# Pluggy secrets — preencher somente no backend, nunca no frontend.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# Configuração local da API da POC
PORT=8787
HOST=127.0.0.1
PLUGGY_ENV=sandbox
PLUGGY_CLIENT_USER_ID=poc-william
PLUGGY_WEBHOOK_HEADER=x-pluggy-webhook-secret
# POC sandbox only: aceita webhooks sem header quando a tela da Pluggy não envia headers customizados no cadastro.
# Desativar em produção.
PLUGGY_ALLOW_UNSIGNED_WEBHOOKS=false
PLUGGY_STORE_PATH=./data/pluggy-poc-store.json

# URL HTTPS pública para cadastrar webhook, quando existir tunnel/deploy.
# Opcional — Conector 200 (Meu Pluggy) não usa webhook, o sync é por polling.
PUBLIC_BASE_URL=

# CORS local do frontend Vite
CORS_ORIGIN=http://127.0.0.1:5175

# --- Sync arquitetura (Pluggy -> Sync Service -> SQLite local) ---
# Caminho do banco SQLite local (financial_items/accounts/transactions/...)
FINANCE_DB_PATH=./data/financeiro-pessoal.sqlite3
# Token exigido no header "Authorization: Bearer <token>" do POST /api/finance/sync.
# Sem este token configurado, o endpoint de sync manual fica bloqueado (401).
FINANCE_API_TOKEN=
# Liga/desliga a rotina periódica de sincronização (cron em processo, sem infra nova).
PLUGGY_SYNC_ENABLED=true
# Intervalo canônico Finance V2 (minutos). Preferir sobre PLUGGY_SYNC_INTERVAL_HOURS.
PLUGGY_SYNC_INTERVAL_MINUTES=15
# Legado — convertido para minutos se MINUTES não estiver definido.
# PLUGGY_SYNC_INTERVAL_HOURS=6
# Janela de sobreposição (horas) subtraída da última transação conhecida por conta,
# para pegar edições retroativas na sincronização incremental.
PLUGGY_SYNC_SAFETY_WINDOW_HOURS=24
# Limite de Items sincronizados em paralelo (rate limit responsável).
PLUGGY_SYNC_MAX_CONCURRENT_ITEMS=3
# Após esse tempo (minutos), um run "running" travado (processo derrubado no meio)
# é considerado morto e a trava é liberada automaticamente no próximo boot.
PLUGGY_SYNC_STALE_LOCK_MINUTES=30
