# Pluggy secrets — preencher somente no backend, nunca no frontend.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# Configuração local da API da POC
PORT=8787
HOST=127.0.0.1
PLUGGY_ENV=sandbox
PLUGGY_CLIENT_USER_ID=poc-william
PLUGGY_WEBHOOK_HEADER=x-pluggy-webhook-secret
# POC sandbox only: aceita webhooks sem header quando a tela da Pluggy não envia headers customizados no cadastro.
# Desativar em produção.
PLUGGY_ALLOW_UNSIGNED_WEBHOOKS=false
PLUGGY_STORE_PATH=./data/pluggy-poc-store.json

# URL HTTPS pública para cadastrar webhook, quando existir tunnel/deploy.
PUBLIC_BASE_URL=

# CORS local do frontend Vite
CORS_ORIGIN=http://127.0.0.1:5175
