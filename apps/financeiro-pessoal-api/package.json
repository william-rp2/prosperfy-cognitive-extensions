{
  "name": "@prosperfy/financeiro-pessoal-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/finance/migrations','dist/finance/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "finance:reprocess": "tsx src/cli/reprocessTransactions.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.11.0",
    "pluggy-sdk": "^0.90.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
