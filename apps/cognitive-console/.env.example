# Cognitive Console — env example (Homolog)

# Required in every environment — no hardcoded fallback exists in code.
# If missing, the app shows a Configuration Error screen instead of
# guessing (and NEVER silently falls back to the production API).
VITE_COGNITIVE_ENV=homolog
VITE_COGNITIVE_API_BASE_URL=https://api-cognitive-homolog.prosperfy.com.br

# Homolog test context — tenant/actor are plain identifiers, safe at build
# time. Never commit real values here.
VITE_COGNITIVE_TEST_TENANT=
VITE_COGNITIVE_TEST_ACTOR=

# NOTE: there is intentionally no VITE_COGNITIVE_TEST_CREDENTIAL var.
# The bearer credential is a secret and must NOT be baked into the build
# (Vite inlines referenced VITE_* vars into the JS bundle, which is
# world-readable via view-source/devtools). Enter it at runtime in the
# Console UI (Homolog Test Session panel) — it is kept only in the
# browser tab's sessionStorage, never written to disk or bundled.
